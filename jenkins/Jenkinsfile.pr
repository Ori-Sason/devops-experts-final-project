// Jenkins job type: multibranch. Triggered on PR open (no additional plugin required)

properties([
    parameters([
        string(name: 'DOCKER_HUB_REPO', defaultValue: 'orisason1/devops-experts-final-project-jenkins', description: 'Repository name in Docker Hub', trim: true)
    ])
])

pipeline {
    agent any

    environment {
        WEB_APP_BUILT = 'false'
        TEST_IMAGE_TAG = "pr-${env.CHANGE_ID}-${env.GIT_COMMIT}"
        TEST_NS = "test-${TEST_IMAGE_TAG}"
        TEST_HELM_CHART_NAME = "test-${BUILD_NUMBER}"
    }

    stages {
        stage('PR validation') {
            when { changeRequest() }

            stages {

                stage('checkout & gitleaks') {
                    steps {
                        checkout scm

                        githubNotify(
                            context: 'jenkins/pr-validation',
                            status: 'PENDING',
                            description: 'Running PR checks...'
                        )

                        script {
                            script {
                                withCredentials([gitUsernamePassword(credentialsId: scm.userRemoteConfigs[0].credentialsId)]) {
                                    sh "git fetch --no-tags origin ${env.CHANGE_TARGET}:refs/remotes/origin/${env.CHANGE_TARGET}"
                                }

                                env.BASE_SHA = sh(
                                    script: "git merge-base HEAD origin/${env.CHANGE_TARGET}",
                                    returnStdout: true
                                ).trim()

                                env.CHANGED_FILES = sh(
                                    script: "git diff --name-only ${env.BASE_SHA} ${env.GIT_COMMIT}",
                                    returnStdout: true
                                ).trim()
                            }
                        }

                        sh """
                            gitleaks detect \
                                --log-opts='${env.BASE_SHA}'..'${env.GIT_COMMIT}' \
                                --verbose \
                                --log-level=debug \
                                --redact
                        """
                    }
                }

                stage('web-app') {
                    when {
                        expression { env.CHANGED_FILES.split('\n').any { it.startsWith('web-app/') } }
                    }

                    environment {
                        UV_INSTALL_DIR  = "${WORKSPACE}/.uv-bin"
                        PATH = "${WORKSPACE}/.uv-bin:/usr/local/bin:${env.PATH}"
                    }

                    stages {
                        stage ('web-app: install and run uv'){
                            steps {
                                sh '''
                                    if ! command -v uv >/dev/null 2>&1; then
                                        curl -LsSf https://astral.sh/uv/install.sh | sh
                                    fi

                                    uv --version
                                    uv sync --package web-app
                                    uv add ruff coverage bandit
                                '''
                            }
                        }

                        stage('web-app: lint & bandit') {
                            steps {
                                dir('web-app') {
                                    echo 'Running lint test using Ruff'
                                    sh 'uv run ruff check .'

                                    echo 'Check for security flaws using bandit'
                                    sh 'uv run bandit -r .'
                                }
                            }
                        }

                        stage('web-app: test') {
                            steps {
                                dir('web-app') {
                                    echo 'Running web-app tests...'
                                    sh '''
                                        uv run coverage run -m unittest discover -s tests
                                        uv run coverage report --fail-under=75
                                    '''
                                }
                            }
                        }

                        stage('web-app: build & push') {
                            steps {
                                echo 'Building and pushing Docker image...'

                                script {
                                    def fullImageName = "${params.DOCKER_HUB_REPO}:${TEST_IMAGE_TAG}"

                                    try {
                                        dockerImage = docker.build(fullImageName, "-f ./web-app/Dockerfile .")

                                        docker.withRegistry('', 'docker-hub') {
                                            dockerImage.push("${TEST_IMAGE_TAG}")
                                        }
                                    } finally {
                                        sh "docker rmi ${fullImageName} || true"
                                    }
                                }
                            }
                        }
                    }

                    post {
                        always {
                            sh '''
                                git reset --hard HEAD
                                git clean -fdx
                            '''
                        }
                        success {
                            echo 'web-app stage completed successfully'
                            script {
                                WEB_APP_BUILT = 'true'
                            }
                        }
                    }
                }

                stage('helm-chart') {
                    when {
                        anyOf {
                            expression { WEB_APP_BUILT == 'true' }
                            expression { env.CHANGED_FILES.split('\n').any { it.startsWith('helm-chart/visit-counter/') } }
                        }
                    }

                    stages {

                        stage('helm-chart: lint') {
                            steps {
                                dir('helm-chart/visit-counter'){
                                    echo 'Linting Helm chart...'
                                    sh 'helm lint .'
                                }
                            }
                        }

                        stage('helm-chart: test') {
                            options {
                                timeout(time: 5, unit: 'MINUTES')
                            }

                            steps {
                                echo 'Testing Helm chart...'

                                script {
                                    testTag = (env.WEB_APP_BUILT == 'true') ? env.TEST_IMAGE_TAG : 'latest'
                                }

                                withCredentials([file(credentialsId: 'k3s-kubeconfig', variable: 'CI_KUBE')]) {
                                    sh """
                                        echo "testTag: ${testTag}"

                                        KUBECONFIG=${CI_KUBE} helm install ${TEST_HELM_CHART_NAME} ./helm-chart/visit-counter \
                                            -f ./helm-chart/visit-counter/values-test.yaml \
                                            --namespace ${TEST_NS} \
                                            --create-namespace \
                                            --set web.image.repository=${params.DOCKER_HUB_REPO} \
                                            --set web.image.tag=${testTag} \
                                            --set currentNamespace=${TEST_NS} \
                                            --wait \
                                            --timeout 3m

                                        KUBECONFIG=${CI_KUBE} helm test ${TEST_HELM_CHART_NAME} \
                                            --namespace ${TEST_NS} \
                                            --logs
                                    """
                                }
                            }

                            post {
                                always {
                                    echo 'Cleaning up environment...'
                                    withCredentials([file(credentialsId: 'k3s-kubeconfig', variable: 'CI_KUBE')]) {
                                        sh """
                                            KUBECONFIG=${CI_KUBE} helm uninstall ${TEST_HELM_CHART_NAME} --namespace ${TEST_NS}
                                            KUBECONFIG=${CI_KUBE} kubectl delete namespace ${TEST_NS} --wait=false || true
                                        """
                                    }
                                }
                            }
                        }
                    }
                }
            }

            post {
                success {
                    githubNotify(
                        context: 'jenkins/pr-validation',
                        status: 'SUCCESS',
                        description: 'All checks passed'
                    )
                }
                failure {
                    githubNotify(
                        context: 'jenkins/pr-validation',
                        status: 'FAILURE',
                        description: 'Checks failed'
                    )
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline complete.'
        }
        failure {
            echo 'Pipeline failed.'
        }
    }
}
